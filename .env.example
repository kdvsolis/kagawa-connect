NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Admin directory uses this so it does not rely on the publishable key.
# Supabase → Project Settings → API → service_role. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# simulation (default) or production.
# simulation: blank DIDIT / PayMongo keys are fine. Test ID + card 4242.
# production: real DIDIT_API_KEY and PAYMONGO_SECRET_KEY are required.
# The test card route returns 403 in production.
NEXT_PUBLIC_KAGAWA_MODE=simulation
KAGAWA_MODE=simulation
NEXT_PUBLIC_KAGAWA_SIM_CARD=4242424242424242
KAGAWA_SIM_CARD=4242424242424242

# App URL (PayMongo success/cancel redirects)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# PayMongo — real GCash / Maya checkout for ₱25 booking fee
# https://dashboard.paymongo.com/
PAYMONGO_SECRET_KEY=sk_test_...
# PAYMONGO_WEBHOOK_SECRET=whsec_...
# Production labor payout: checkout lands in this wallet, then InstaPay sends it
# to the worker GCash. Leave blank to read the wallet from GET /v2/wallets.
# PAYMONGO_SOURCE_ACCOUNT_NUMBER=
# PAYMONGO_SOURCE_ACCOUNT_NAME=
# PAYMONGO_SOURCE_BIC=PAEYPHM2XXX
# PAYMONGO_GCASH_BIC=GXCHPHM2XXX
# Webhook: POST {APP_URL}/api/payments/webhook  (payment.paid starts the transfer)

# Set false in production when PayMongo is live (blocks /api/payments/demo-confirm)
# PAYMENTS_ALLOW_DEMO=true

# Didit KYC — Fast ID check (hosted). Server-only secrets.
# Console: https://business.didit.me
# workflow_id is NOT an env var — see src/lib/kyc/didit.ts (DIDIT_WORKFLOW_ID)
DIDIT_API_KEY=
# From console → Webhooks → signing secret (public HTTPS URL only; no localhost)
# DIDIT_WEBHOOK_SECRET=

# OpenBiometrics — optional self-hosted face match fallback
# Setup: docker compose -f docker-compose.openbiometrics.yml up -d
# Docs: https://docs.openbiometrics.dev/
# OPENBIOMETRICS_BASE_URL=http://127.0.0.1:8000
# OPENBIOMETRICS_API_KEY=local
# OPENBIOMETRICS_THRESHOLD=0.4

# Admin (/admin) — separate from customer/worker accounts.
# JWT signs only admin APIs. Password is checked against admin_accounts
# after the migration; until then these env values are the first login.
# ADMIN_SECRET is no longer used.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-8
ADMIN_JWT_SECRET=change-me-long-random-secret

# Groq — smarter “what needs fixing?” suggest on book page
# https://console.groq.com/keys  (never commit real keys — use .env.local)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# Web Push (optional, production) — VAPID keys for true closed-app push
# Generate: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
